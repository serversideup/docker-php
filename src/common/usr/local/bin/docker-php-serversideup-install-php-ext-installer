#!/bin/sh
set -e

###################################################
# Usage: docker-php-serversideup-install-php-ext-installer [version]
###################################################
# This script installs the "install-php-extensions" script from 
# https://github.com/mlocati/docker-php-extension-installer
# Our images pass the PHP_EXT_INSTALLER_VERSION build arg from
# scripts/conf/php-versions-base-config.yml. Without a version, the latest release is used.
script_name="docker-php-serversideup-install-php-ext-installer"

############
# Main
############
PHP_EXT_INSTALLER_VERSION="${1:-${PHP_EXT_INSTALLER_VERSION:-latest}}"

if [ "$PHP_EXT_INSTALLER_VERSION" = "latest" ]; then
    download_url="https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions"
else
    download_url="https://github.com/mlocati/docker-php-extension-installer/releases/download/$PHP_EXT_INSTALLER_VERSION/install-php-extensions"
fi

docker-php-serversideup-download "$download_url" /usr/local/bin/install-php-extensions
chmod +x /usr/local/bin/install-php-extensions

echo "$script_name: ⚡️ Installed $PHP_EXT_INSTALLER_VERSION of \"install-php-extensions\""