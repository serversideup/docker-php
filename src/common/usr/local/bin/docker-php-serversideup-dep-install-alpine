#!/bin/sh
set -oe

###################################################
# Usage: docker-php-serversideup-dep-install-alpine [alpine-packages]
#
# Packages may be passed as separate arguments, comma-delimited, or both:
#
#     docker-php-serversideup-dep-install-alpine git, zip
#
#     docker-php-serversideup-dep-install-alpine \
#         git \
#         zip
###################################################
# This script installs alpine packages that are passed to it

script_name="docker-php-serversideup-dep-install-alpine"

############
# Sanity checks
############
if [ -f /etc/os-release ]; then
    # Source the os-release file (including the $NAME variable)
    . /etc/os-release
else
    echo "🛑 ERROR ($script_name): Unable to determine the OS."
    exit 1
fi

if [ "$NAME" != "Alpine Linux" ] || [ $# -eq 0 ]; then
    echo "ℹ️ INFO ($script_name): No arguments were passed or the OS is not Alpine Linux. Continuing..."
    exit 0
fi

############
# Functions
############
# Accepts any mix of space-separated arguments and comma-delimited lists
# (e.g. "pkg1, pkg2" or "pkg1 pkg2" or "pkg1 \ pkg2" across lines in a Dockerfile)
convert_comma_delimited_to_space_separated() {
    printf '%s\n' "$*" | tr ',' ' '
}

############
# Main
############
# Re-split into one argument per package. Globbing is disabled so a package
# name such as "php*" is never expanded against files in the working directory.
set -f
set -- $(convert_comma_delimited_to_space_separated "$@")
set +f

if [ $# -eq 0 ]; then
    echo "ℹ️ INFO ($script_name): No packages were found in the arguments. Continuing..."
    exit 0
fi

# "$*" joins the packages with single spaces for display
DEP_PACKAGES="$*"
echo "🤖 Installing: $DEP_PACKAGES"
apk update
apk add --no-cache "$@"


echo "🧼 Cleaning up installation of: $DEP_PACKAGES"
rm -rf /var/cache/apk/*

echo "⚡️ Completed installation of: $DEP_PACKAGES"
