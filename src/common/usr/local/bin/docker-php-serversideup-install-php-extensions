#!/bin/sh
set -e

###################################################
# Usage: docker-php-serversideup-install-php-extensions [extensions] [overrides]
###################################################
# This script installs PHP extensions with "install-php-extensions", optionally
# swapping an extension for a different source. Overrides are space separated
# "name=source" pairs, where source is any value install-php-extensions accepts
# (for example "redis=phpredis/phpredis@develop").
#
# GitHub's source tarballs leave out git submodules, so a GitHub source can list
# them after a "+" as "path=owner/repo@ref" (for example
# "redis=phpredis/phpredis@<commit>+liblzf=nemequ/liblzf@<commit>"). Each one is
# downloaded into that path and the assembled directory is installed instead.

script_name="docker-php-serversideup-install-php-extensions"

extensions="${1:-}"
overrides="${2:-}"

if [ -z "$extensions" ]; then
    echo "ℹ️ INFO ($script_name): No extensions were passed. Continuing..."
    exit 0
fi

############
# Functions
############
resolve_extension_source() {
    resolved_extension="$1"
    for override in $overrides; do
        if [ "${override%%=*}" = "$1" ]; then
            resolved_extension="${override#*=}"
        fi
    done
}

# Sets assembled_source_dir.
assemble_github_source() {
    assembled_source_dir=$(mktemp -d)
    for part in $(printf '%s' "$1" | tr '+' ' '); do
        case "$part" in
            *=*) target_dir="$assembled_source_dir/${part%%=*}" repository="${part#*=}" ;;
            *) target_dir="$assembled_source_dir" repository="$part" ;;
        esac
        mkdir -p "$target_dir"
        docker-php-serversideup-download "https://codeload.github.com/${repository%@*}/tar.gz/${repository#*@}" "$assembled_source_dir.tar.gz"
        tar -xzf "$assembled_source_dir.tar.gz" --strip-components 1 -C "$target_dir"
        rm -f "$assembled_source_dir.tar.gz"
    done
    assembled_source_dirs="$assembled_source_dirs $assembled_source_dir"
}

############
# Main
############
resolved_extensions=""
assembled_source_dirs=""
for extension in $extensions; do
    resolve_extension_source "$extension"
    case "$resolved_extension" in
        *+*)
            echo "📦 Assembling $extension from $resolved_extension"
            assemble_github_source "$resolved_extension"
            resolved_extension="$assembled_source_dir"
            ;;
    esac
    resolved_extensions="$resolved_extensions $resolved_extension"
done

echo "🤖 Installing PHP extensions:$resolved_extensions"
install-php-extensions $resolved_extensions

rm -rf $assembled_source_dirs

echo "⚡️ Completed installation of PHP extensions:$resolved_extensions"
